{
    "compilerOptions": {
        "target": "ES6",
        "esModuleInterop": true,
        "strict": true,
        "moduleResolution": "Node",
        "noEmit": true,

        "outDir": "dist",

        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitAny": true,

        "baseUrl": "src",
        "paths": {
            "@/*": ["*"]
        },
        "typeRoots": ["./src/types", "./node_modules/@types"]
    },
    "tsc-alias": {
        "resolveFullPaths": true,
        "verbose": false
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "docs"]
}
