{
  "name": "unclocked-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach --parallel run dev",
    "build": "yarn workspaces foreach run build",
    "start": "yarn workspace backend start",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  }
}
